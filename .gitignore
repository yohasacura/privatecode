node_modules/
dist/
target/
__pycache__/
*.log
docs/SPIKE-*.json
tools/roslyn-nav/bin/
tools/roslyn-nav/obj/

# .NET build output from the vendored helpers. Only the PUBLISHED binary belongs in the
# repository (under vendor/), and it is copied there deliberately -- bin/ and obj/ are
# hundreds of intermediate files that change on every build.
tools/*/bin/
tools/*/obj/

# Vendored binaries: 382 MB, and sql-probe.exe alone is past GitHub's hard 100 MiB per-file
# limit, so a repository carrying them cannot be pushed at all. `scripts/fetch-vendor.mjs`
# rebuilds the whole tree from the sources each PROVENANCE.md names, verifying the
# publisher's own SHA-256 on the way — a stronger guarantee than a committed blob. The
# PROVENANCE files stay in git -- they ARE the source of truth -- and so do the third-party
# licence texts, so a reader can see what the release bundles without running anything.
vendor/*/*.exe
vendor/*/*.dll
vendor/*/*.wasm

# Staged by ext/scripts/stage-vendor.mjs from vendor/ at build time.
ext/vendor/

# Debug symbols from the sql-probe publish; never belonged in the tree.
sql-probe.pdb

# Release artefacts, built by scripts/package-release.mjs.
release/

# Vitest's own run cache. It records which tests passed on the machine that last ran them,
# which is a fact about that machine and nothing else -- it was committed once and then
# carried a stale verdict around for anyone who cloned.
.vite/
