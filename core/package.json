{
  "name": "@privatecode/core",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "//": "AbortSignal.any (llama/client.ts, agent/loop.ts) landed in Node 20.3; on anything older every model call throws TypeError at the first request.",
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "agent": "tsx src/cli.ts",
    "bundle": "node scripts/bundle.mjs",
    "host:dev": "tsx src/host/ws-bridge.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.23.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "execa": "^9.5.0",
    "linkedom": "^0.18.13",
    "web-tree-sitter": "^0.24.7"
  }
}
